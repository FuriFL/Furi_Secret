modules = ["python-3.12"]

[nix]
channel = "stable-25_05"
packages = ["ffmpeg", "libsodium"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run Discord bot"

[[workflows.workflow]]
name = "Run Discord bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -u main.py"

[workflows.workflow.metadata]
outputType = "console"
